---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      title: "Every solution begins with a question.",
      statement:
        "We don't start with technology. We start with what needs to work.",
    }
  : {
      title: "Ogni soluzione comincia da una domanda.",
      statement:
        "Non partiamo dalla tecnologia. Partiamo da ciò che deve funzionare.",
    };
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-composition">
      <div class="hero-statement">
        <h1>{content.title}</h1>
      </div>

      <div class="hero-green">
        <div class="green-content">
          <p>{content.statement}</p>

        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .hero {
    padding: 48px 0 0;
    background: $color-cream;
  }

  .hero-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;
  }

  /* --------------------------------
     Main composition
  -------------------------------- */

  .hero-composition {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr);

    height: calc(100svh - 165px);

    min-height: 500px;

    margin-top: 20px;
  }

  .hero-statement {
    display: flex;
    align-items: center;

    padding: 24px 56px 40px 0;
  }

  h1 {
    max-width: 900px;

    margin: 0;

    color: $color-ink;

    font-family: $font-display;
    font-size: clamp(3.7rem, 6.2vw, 6.5rem);
    font-weight: 400;
    line-height: 0.89;
    letter-spacing: -0.045em;
  }

  /* --------------------------------
     Green surface
  -------------------------------- */

  .hero-green {
    position: relative;

    height: min(330px, 70%);
    align-self: center;

    background: $color-green;
    color: $color-cream;
  }

  .green-content {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 28px;
  }

  .green-content p {
    max-width: 290px;

    margin: 0;

    font-family: $font-display;
    font-size: clamp(1.45rem, 2vw, 2rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .green-number {
    align-self: flex-end;

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
  }

  /* --------------------------------
     Tablet
  -------------------------------- */

  @media (max-width: 1000px) {
    .hero {
      padding-top: 40px;
    }

    .hero-composition {
      grid-template-columns: minmax(0, 7fr) minmax(230px, 5fr);

      height: calc(100svh - 150px);

      min-height: 480px;
    }

    .hero-statement {
      padding-right: 36px;
    }

    h1 {
      font-size: clamp(3.5rem, 7vw, 6rem);
    }

    .hero-green {
      height: min(310px, 68%);
    }

    .green-content {
      padding: 24px;
    }

    .green-content p {
      font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    }
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 768px) {
    .hero {
      padding: 36px 0 64px;
    }

    .hero-inner {
      width: calc(100% - 40px);
    }

    .hero-composition {
      display: block;

      height: auto;
      min-height: 0;

      margin-top: 48px;
    }

    .hero-statement {
      display: block;

      padding: 0 0 36px;
    }

    h1 {
      max-width: 620px;

      font-size: clamp(3.2rem, 13vw, 5rem);
      line-height: 0.9;
      letter-spacing: -0.04em;
    }

    .hero-green {
      width: 78%;
      height: 260px;
      min-height: 0;

      margin-left: auto;
    }

    .green-content {
      padding: 24px;
    }

    .green-content p {
      max-width: 250px;

      font-size: clamp(1.45rem, 6vw, 1.9rem);
    }
  }

  /* --------------------------------
     Small mobile
  -------------------------------- */

  @media (max-width: 480px) {
    .hero {
      padding-top: 28px;
    padding-bottom: 56px;
    }

    .hero-inner {
      width: calc(100% - 40px);
    }

    .hero-composition {
      margin-top: 44px;
    }

    .hero-statement {
      padding-bottom: 32px;
    }

    h1 {
      font-size: clamp(3rem, 13.5vw, 4.5rem);
    }

    .hero-green {
      width: 82%;
      height: 220px;
    }

    .green-content {
      padding: 20px;
    }

    .green-content p {
      max-width: 220px;
      font-size: 1.4rem;
    }
  }
</style>
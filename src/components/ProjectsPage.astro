---
import quandononcisonoCover from "../assets/projects/quandononcisono/cover.jpeg";
import studioLeoneCover from "../assets/projects/studio-leone/cover.jpeg";

const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      label: "Selected work",
      title: "Digital products built around real ideas.",
      intro:
        "Every project starts with a different need. I work across websites, web applications and custom digital tools, choosing the right approach for each context rather than forcing every problem into the same solution.",
      projects: [
        {
          number: "01",
          name: "quandononcisono",
          category: "Editorial web application",
          description:
            "A custom digital publishing platform built from scratch for an independent editorial project.",
          details:
            "The project brings together editorial content, short stories, podcasting and newsletter management in a single digital environment. The goal was to create a platform that could support the identity of the project while giving its author complete control over publishing and content management.",
          services: "Web application · CMS · Podcast · Newsletter",
          image: quandononcisonoCover,
        },
        {
          number: "02",
          name: "Studio Leone",
          category: "Professional website",
          description:
            "A refined digital presence designed and developed for a psychology practice.",
          details:
            "The website was designed around clarity, trust and simplicity, creating an understated digital presence that communicates the identity of the practice while making essential information easy to find.",
          services: "Website · Responsive design · SEO",
          image: studioLeoneCover,
        },
      ],
      ctaTitle: "Have a project in mind?",
      ctaDescription:
        "Tell me what you are trying to build, improve or simplify. We can start from the problem and find the right digital solution together.",
      ctaButton: "Start a conversation",
    }
  : {
      label: "Progetti selezionati",
      title: "Prodotti digitali costruiti intorno a idee reali.",
      intro:
        "Ogni progetto nasce da un'esigenza diversa. Lavoro su siti web, applicazioni web e strumenti digitali su misura, scegliendo l'approccio più adatto al contesto invece di applicare la stessa soluzione a ogni problema.",
      projects: [
        {
          number: "01",
          name: "quandononcisono",
          category: "Web application editoriale",
          description:
            "Una piattaforma editoriale digitale sviluppata da zero per un progetto editoriale indipendente.",
          details:
            "Il progetto riunisce contenuti editoriali, racconti, podcast e gestione della newsletter in un unico ambiente digitale. L'obiettivo era creare una piattaforma capace di sostenere l'identità del progetto, offrendo al tempo stesso all'autore il pieno controllo sulla pubblicazione e sulla gestione dei contenuti.",
          services: "Web application · CMS · Podcast · Newsletter",
          image: quandononcisonoCover,
        },
        {
          number: "02",
          name: "Studio Leone",
          category: "Sito web professionale",
          description:
            "Una presenza digitale essenziale e curata, progettata e sviluppata per uno studio di psicologia.",
          details:
            "Il sito è stato progettato intorno a chiarezza, fiducia e semplicità, costruendo una presenza digitale discreta che comunica l'identità dello studio e rende le informazioni essenziali facili da trovare.",
          services: "Sito web · Responsive design · SEO",
          image: studioLeoneCover,
        },
      ],
      ctaTitle: "Hai un progetto in mente?",
      ctaDescription:
        "Raccontami cosa vuoi costruire, migliorare o semplificare. Possiamo partire dal problema e trovare insieme la soluzione digitale più adatta.",
      ctaButton: "Parliamone",
    };
---

<section class="projects-hero">
  <div class="projects-hero-inner">
    <div class="section-label">
      <span>/ 01</span>
      <span>{content.label}</span>
    </div>

    <h1>{content.title}</h1>

    <p class="projects-intro">{content.intro}</p>
  </div>
</section>

<section
  class="projects-list"
  aria-label={isEnglish ? "Selected projects" : "Progetti selezionati"}
>
  <div class="projects-list-inner">
    {
      content.projects.map((project) => (
        <article class="project">
          <div class="project-header">
            <div class="project-number">{project.number}</div>

            <div class="project-heading">
              <span class="project-category">{project.category}</span>
              <h2>{project.name}</h2>
            </div>
          </div>

          <div class="project-visual">
            <img
              src={project.image.src}
              alt={
                isEnglish
                  ? `${project.name} project preview`
                  : `Anteprima del progetto ${project.name}`
              }
            />
          </div>

          <div class="project-content">
            <div class="project-main">
              <p class="project-description">{project.description}</p>

              <p class="project-details">{project.details}</p>
            </div>

            <div class="project-services">
              <span class="project-label">
                {isEnglish ? "Scope" : "Intervento"}
              </span>

              <p>{project.services}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="projects-cta">
  <div class="projects-cta-inner">
    <div class="section-label">
      <span>/ 02</span>
      <span>{isEnglish ? "Start a project" : "Iniziamo un progetto"}</span>
    </div>

    <div class="projects-cta-content">
      <h2>{content.ctaTitle}</h2>

      <div class="projects-cta-bottom">
        <p>{content.ctaDescription}</p>

        <a href={isEnglish ? "/en/contact" : "/contatti"}>
          <span>{content.ctaButton}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .projects-hero,
  .projects-list,
  .projects-cta {
    padding: 180px $container-padding;
    border-top: 1px solid $color-border;
  }

  .projects-hero-inner,
  .projects-list-inner,
  .projects-cta-inner {
    width: 100%;
    max-width: $container-max-width;
    margin: 0 auto;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 24px;

    font-family: $font-mono;
    font-size: 0.65rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-muted;
  }

  h1 {
    max-width: 1000px;
    margin: 100px 0 0;

    font-family: $font-display;
    font-size: clamp(4rem, 8vw, 8rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .projects-intro {
    max-width: 640px;
    margin: 60px 0 0 120px;

    font-size: 1rem;
    line-height: 1.75;
    color: $color-muted;
  }

  .projects-list {
    padding-top: 0;
  }

  .project {
    padding: 100px 0;
    border-top: 1px solid $color-border;
  }

  .project:last-child {
    border-bottom: 1px solid $color-border;
  }

  .project-header {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 40px;
  }

  .project-number,
  .project-category,
  .project-label {
    font-family: $font-mono;
    font-size: 0.65rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-muted;
  }

  .project-heading {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-heading h2 {
    margin: 0;

    font-family: $font-display;
    font-size: clamp(3.5rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .project-visual {
    margin-top: 60px;
    overflow: hidden;
  }

  .project-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-content {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 100px;

    margin-top: 48px;
    padding-left: 120px;
  }

  .project-main {
    max-width: 680px;
  }

  .project-description {
    margin: 0;

    font-family: $font-display;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .project-details {
    margin: 32px 0 0;

    font-size: 0.95rem;
    line-height: 1.7;
    color: $color-muted;
  }

  .project-services {
    align-self: end;
    max-width: 360px;
  }

  .project-services .project-label {
    display: block;
    margin-bottom: 16px;
  }

  .project-services p {
    margin: 0;

    font-size: 0.9rem;
    line-height: 1.7;
    color: $color-muted;
  }

  .projects-cta-content {
    margin-top: 100px;
  }

  .projects-cta-content h2 {
    max-width: 900px;
    margin: 0;

    font-family: $font-display;
    font-size: clamp(3.5rem, 7vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .projects-cta-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;

    margin-top: 70px;
    padding-left: 120px;
  }

  .projects-cta-bottom p {
    max-width: 460px;
    margin: 0;

    font-size: 0.95rem;
    line-height: 1.7;
    color: $color-muted;
  }

  .projects-cta-bottom a {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    flex-shrink: 0;

    font-family: $font-mono;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    color: $color-accent;
  }

  .projects-cta-bottom a span:last-child {
    font-size: 1.1rem;
    transition: transform $transition-fast;
  }

  .projects-cta-bottom a:hover span:last-child {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .projects-hero,
    .projects-list,
    .projects-cta {
      padding: 120px $container-padding;
    }

    h1 {
      margin-top: 80px;
      font-size: clamp(3.5rem, 13vw, 6rem);
    }

    .projects-intro {
      margin: 48px 0 0;
    }

    .project {
      padding: 80px 0;
    }

    .project-header {
      grid-template-columns: 48px 1fr;
      gap: 20px;
    }

    .project-heading h2 {
      font-size: clamp(3rem, 11vw, 5rem);
    }

    .project-visual {
      margin-top: 40px;
    }

    .project-content {
      grid-template-columns: 1fr;
      gap: 48px;

      margin-top: 40px;
      padding-left: 68px;
    }

    .project-description {
      font-size: 1.3rem;
    }

    .projects-cta-content {
      margin-top: 80px;
    }

    .projects-cta-content h2 {
      font-size: clamp(3rem, 12vw, 5rem);
    }

    .projects-cta-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;

      margin-top: 60px;
      padding-left: 0;
    }
  }

  @media (max-width: 600px) {
    .project-content {
      padding-left: 0;
    }
  }
</style>

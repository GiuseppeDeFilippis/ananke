---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      eyebrow: "The starting point",
      title:
        "Before building, we need to understand what is worth building.",
      description:
        "Every project starts with a need, an idea or something that does not work as it should. The work begins before the code: understanding the context, defining the problem and finding a direction.",
    }
  : {
      eyebrow: "Il punto di partenza",
      title: "Prima di costruire, bisogna capire cosa vale la pena costruire.",
      description:
        "Ogni progetto parte da una necessità, un'idea o qualcosa che non funziona come dovrebbe. Il lavoro comincia prima del codice: capire il contesto, mettere a fuoco il problema e trovare una direzione.",
    };
---

<section class="intro">
  <div class="intro-inner">
    <div class="intro-eyebrow">
      <span>{content.eyebrow}</span>
    </div>

    <div class="intro-content">
      <h2>{content.title}</h2>

      <p>{content.description}</p>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .intro {
    background: $color-green;
    color: $color-cream;
    padding: 140px 0 160px;
  }

  .intro-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;
  }

  .intro-eyebrow {
    margin-bottom: 80px;

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro-content {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
  }

  h2 {
    grid-column: 1 / span 8;

    max-width: 900px;

    margin: 0;

    font-family: $font-display;
    font-size: clamp(3.4rem, 5.6vw, 6.1rem);
    font-weight: 400;
    line-height: 0.91;
    letter-spacing: -0.04em;
  }

  p {
    grid-column: 8 / span 4;

    align-self: end;

    max-width: 470px;

    margin: 0 0 8px;

    color: rgba(245, 243, 238, 0.72);

    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* --------------------------------
     Tablet
  -------------------------------- */

  @media (max-width: 1000px) {
    .intro {
      padding: 110px 0 120px;
    }

    .intro-eyebrow {
      margin-bottom: 60px;
    }

    h2 {
      grid-column: 1 / span 9;

      font-size: clamp(3.25rem, 6vw, 5.5rem);
    }

    p {
      grid-column: 7 / span 6;
    }
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 768px) {
    .intro {
      padding: 90px 0 100px;
    }

    .intro-eyebrow {
      margin-bottom: 48px;
    }

    .intro-content {
      display: block;
    }

    h2 {
      font-size: clamp(3rem, 13vw, 5rem);
      line-height: 0.92;
    }

    p {
      max-width: 480px;

      margin-top: 48px;
      margin-bottom: 0;

      font-size: 0.95rem;
    }
  }

  /* --------------------------------
     Small mobile
  -------------------------------- */

  @media (max-width: 480px) {
    .intro {
      padding: 72px 0 80px;
    }

    .intro-eyebrow {
      margin-bottom: 40px;
    }

    h2 {
      font-size: clamp(2.8rem, 13.5vw, 4.5rem);
    }

    p {
      margin-top: 40px;
    }
  }
</style>
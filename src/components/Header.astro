---
import { getRelativeLocaleUrl } from "astro:i18n";

const currentLocale = Astro.currentLocale ?? "it";
const currentPath = Astro.url.pathname;

const localeRoutes: Record<string, string> = {
  "/": "/en/",
  "/servizi": "/en/services",
  "/progetti": "/en/work",
  "/processo": "/en/process",
  "/chi-sono": "/en/about",
  "/contatti": "/en/contact",
};

const englishRoutes: Record<string, string> = {
  "/en/": "/",
  "/en/services": "/servizi",
  "/en/work": "/progetti",
  "/en/process": "/processo",
  "/en/about": "/chi-sono",
  "/en/contact": "/contatti",
};

const alternateUrl =
  currentLocale === "en"
    ? englishRoutes[currentPath] ?? "/"
    : localeRoutes[currentPath] ?? "/en/";

const isEnglish = currentLocale === "en";
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="brand"
      href={getRelativeLocaleUrl(currentLocale)}
      aria-label="ANANKE — home"
    >
      <span class="brand-name">ANANKE</span>
      <span class="brand-subtitle">Independent Software Studio</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={isEnglish ? "/en/services" : "/servizi"}>
        {isEnglish ? "Services" : "Servizi"}
      </a>

      <a href={isEnglish ? "/en/work" : "/progetti"}>
        {isEnglish ? "Work" : "Progetti"}
      </a>

      <a href={isEnglish ? "/en/process" : "/processo"}>
        {isEnglish ? "Process" : "Processo"}
      </a>

      <a href={isEnglish ? "/en/about" : "/chi-sono"}>
        {isEnglish ? "Studio" : "Studio"}
      </a>

      <a href={isEnglish ? "/en/contact" : "/contatti"}>
        {isEnglish ? "Contact" : "Contatti"}
      </a>

      <a class="language-link" href={alternateUrl}>
        {isEnglish ? "IT" : "EN"}
      </a>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-label={isEnglish ? "Open menu" : "Apri menu"}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span>Menu</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav aria-label="Mobile navigation">
      <a href={isEnglish ? "/en/services" : "/servizi"}>
        {isEnglish ? "Services" : "Servizi"}
      </a>

      <a href={isEnglish ? "/en/work" : "/progetti"}>
        {isEnglish ? "Work" : "Progetti"}
      </a>

      <a href={isEnglish ? "/en/process" : "/processo"}>
        {isEnglish ? "Process" : "Processo"}
      </a>

      <a href={isEnglish ? "/en/about" : "/chi-sono"}>
        Studio
      </a>

      <a href={isEnglish ? "/en/contact" : "/contatti"}>
        {isEnglish ? "Contact" : "Contatti"}
      </a>

      <a class="mobile-language" href={alternateUrl}>
        {isEnglish ? "Italiano" : "English"}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>(".mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("is-open", !isOpen);
    document.body.classList.toggle("menu-open", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      menu?.classList.remove("is-open");
      document.body.classList.remove("menu-open");
    });
  });
</script>

<style lang="scss">
  @use "../styles/variables" as *;

  .site-header {
    position: relative;
    z-index: 100;
    padding: 24px 0;
  }

  .header-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    color: $color-green;
  }

  .brand-name {
    font-family: $font-display;
    font-size: 2rem;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .brand-subtitle {
    margin-top: 7px;

    font-family: $font-mono;
    font-size: 0.6rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;

    padding-top: 5px;

    font-family: $font-mono;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .desktop-nav a {
    position: relative;
    transition: color $transition-fast;
  }

  .desktop-nav a:not(.language-link)::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -5px;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: right;

    transition: transform $transition-fast;
  }

  .desktop-nav a:not(.language-link):hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-link {
    margin-left: 8px;
    color: $color-green;
  }

  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;

      padding-top: 4px;

      color: $color-green;

      font-family: $font-mono;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .menu-toggle span {
      position: relative;
    }

    .mobile-menu {
      position: fixed;
      inset: 0;
      z-index: -1;

      display: flex;
      align-items: flex-end;

      padding: 120px 24px 32px;

      background: $color-green;
      color: $color-cream;

      opacity: 0;
      visibility: hidden;

      transition:
        opacity $transition-base,
        visibility $transition-base;
    }

    .mobile-menu.is-open {
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .mobile-menu nav a {
      font-family: $font-display;
      font-size: clamp(2.5rem, 10vw, 4rem);
      line-height: 1;
      letter-spacing: -0.025em;
    }

    .mobile-menu .mobile-language {
      margin-top: 28px;

      font-family: $font-mono;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    body.menu-open {
      overflow: hidden;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      padding: 20px 0;
    }

    .header-inner {
      width: calc(100% - 40px);
    }

    .brand-name {
      font-size: 1.75rem;
    }

    .brand-subtitle {
      font-size: 0.55rem;
    }
  }
</style>
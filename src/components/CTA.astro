---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      eyebrow: "A possibility",
      title: "Every project begins with something that does not exist yet.",
      description:
        "If you have an idea, a problem or something that could work better, we can start there.",
      link: "Let's talk",
    }
  : {
      eyebrow: "Una possibilità",
      title: "Ogni progetto comincia da qualcosa che ancora non esiste.",
      description:
        "Se hai un'idea, un problema o qualcosa che potrebbe funzionare meglio, possiamo iniziare da lì.",
      link: "Parliamone",
    };
---

<section class="cta">
  <div class="cta-inner">
    <div class="cta-header">
      <span class="eyebrow">{content.eyebrow}</span>

      <h2>{content.title}</h2>
    </div>

    <div class="cta-bottom">
      <p>{content.description}</p>

      <a href="/contatti" class="cta-link">
        <span>{content.link}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .cta {
    padding: 140px 0 150px;

    background: $color-green;
    color: $color-cream;
  }

  .cta-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;
  }

  /* --------------------------------
     Header
  -------------------------------- */

  .cta-header {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;

    margin-bottom: 100px;
  }

  .eyebrow {
    grid-column: 1 / span 3;

    color: rgba(245, 243, 238, 0.72);

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    grid-column: 4 / span 8;

    max-width: 900px;

    margin: 0;

    font-family: $font-display;
    font-size: clamp(3.5rem, 5.8vw, 6.2rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  /* --------------------------------
     Bottom
  -------------------------------- */

  .cta-bottom {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;

    align-items: end;
  }

  .cta-bottom p {
    grid-column: 7 / span 4;

    max-width: 420px;

    margin: 0;

    color: rgba(245, 243, 238, 0.72);

    font-size: 1rem;
    line-height: 1.7;
  }

  .cta-link {
    grid-column: 11 / span 2;

    display: inline-flex;
    align-items: center;
    justify-content: space-between;

    padding-bottom: 8px;

    border-bottom: 1px solid rgba(245, 243, 238, 0.55);

    color: $color-cream;

    font-family: $font-mono;
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;

    transition:
      border-color $transition-base,
      padding-bottom $transition-base;
  }

  .cta-link span:last-child {
    font-size: 1rem;

    transition: transform $transition-base;
  }

  .cta-link:hover {
    padding-bottom: 12px;

    border-color: $color-cream;
  }

  .cta-link:hover span:last-child {
    transform: translate(3px, -3px);
  }

  /* --------------------------------
     Tablet
  -------------------------------- */

  @media (max-width: 1000px) {
    .cta {
      padding: 120px 0 130px;
    }

    .cta-header {
      margin-bottom: 80px;
    }

    h2 {
      grid-column: 4 / span 9;

      font-size: clamp(3.2rem, 5.8vw, 5.5rem);
    }

    .cta-bottom p {
      grid-column: 7 / span 5;
    }

    .cta-link {
      grid-column: 12;
    }
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 768px) {
    .cta {
      padding: 90px 0 100px;
    }

    .cta-header {
      display: block;

      margin-bottom: 56px;
    }

    .eyebrow {
      display: block;

      margin-bottom: 40px;
    }

    h2 {
      font-size: clamp(3rem, 13vw, 5rem);
      line-height: 0.92;
    }

    .cta-bottom {
      display: block;
    }

    .cta-bottom p {
      max-width: 460px;

      margin-bottom: 40px;

      font-size: 0.95rem;
    }

    .cta-link {
      display: inline-flex;

      width: 100%;
      max-width: 240px;
    }
  }

  /* --------------------------------
     Small mobile
  -------------------------------- */

  @media (max-width: 480px) {
    .cta {
      padding: 72px 0 80px;
    }

    .cta-header {
      margin-bottom: 48px;
    }

    .eyebrow {
      margin-bottom: 32px;
    }

    h2 {
      font-size: clamp(2.8rem, 13.5vw, 4.5rem);
    }

    .cta-bottom p {
      margin-bottom: 32px;
    }
  }
</style>
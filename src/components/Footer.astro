---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      navigation: "Navigation",
      contact: "Get in touch",
      contactText: "Have a project in mind?",
      email: "giuseppe@ananke.dev",
      copyright: "© 2026 Giuseppe De Filippis. All rights reserved.",
    }
  : {
      navigation: "Navigazione",
      contact: "Contatti",
      contactText: "Hai un progetto in mente?",
      email: "giuseppe@ananke.dev",
      copyright: "© 2026 Giuseppe De Filippis. Tutti i diritti riservati.",
    };

const navigation = isEnglish
  ? [
      { label: "Home", href: "/" },
      { label: "Services", href: "/servizi" },
      { label: "Projects", href: "/progetti" },
      { label: "Process", href: "/processo" },
      { label: "About", href: "/chi-sono" },
      { label: "Contact", href: "/contatti" },
    ]
  : [
      { label: "Home", href: "/" },
      { label: "Servizi", href: "/servizi" },
      { label: "Progetti", href: "/progetti" },
      { label: "Processo", href: "/processo" },
      { label: "Chi sono", href: "/chi-sono" },
      { label: "Contatti", href: "/contatti" },
    ];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-name">ANANKE</span>
          <span class="footer-logo-subtitle">INDEPENDENT SOFTWARE STUDIO</span>
        </a>
      </div>

      <div class="footer-contact">
        <span class="footer-label">{content.contact}</span>

        <a href="/contatti" class="footer-contact-link">
          {content.contactText}
          <span aria-hidden="true">↗</span>
        </a>

        <a href="mailto:{content.email}" class="footer-email">
          {content.email}
        </a>
      </div>

      <nav class="footer-navigation" aria-label={content.navigation}>
        <span class="footer-label">{content.navigation}</span>

        <div class="footer-links">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>{content.copyright}</span>

      <div class="footer-meta">
        <a href="/privacy">Privacy</a>
        <a href="/cookie">Cookie</a>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  @use "../styles/variables" as *;

  .footer {
    padding: 70px $container-padding 28px;
    border-top: 1px solid $color-border;
  }

  .footer-inner {
    width: 100%;
    max-width: $container-max-width;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 60px;

    padding-bottom: 70px;
  }

  .footer-brand,
  .footer-contact,
  .footer-navigation {
    display: flex;
    flex-direction: column;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    display: flex;
    flex-direction: column;
    width: fit-content;

    color: $color-text;
  }

  .footer-logo-name {
    font-family: $font-display;
    font-size: 1.8rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .footer-logo-subtitle {
    margin-top: 6px;

    font-family: $font-mono;
    font-size: 0.65rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-muted;
  }

  .footer-label {
    font-family: $font-mono;
    font-size: 0.65rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-muted;
  }

  .footer-contact {
    gap: 14px;
  }

  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    width: fit-content;

    font-family: $font-display;
    font-size: 1.35rem;
    line-height: 1.1;

    color: $color-text;
  }

  .footer-contact-link span {
    font-family: $font-mono;
    font-size: 0.9rem;
    color: $color-accent;

    transition: transform $transition-fast;
  }

  .footer-contact-link:hover span {
    transform: translate(3px, -3px);
  }

  .footer-email {
    width: fit-content;

    font-size: 0.85rem;
    color: $color-muted;

    transition: color $transition-fast;
  }

  .footer-email:hover {
    color: $color-text;
  }

  .footer-navigation {
    gap: 14px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 8px 30px;
  }

  .footer-links a {
    width: fit-content;

    font-size: 0.85rem;
    color: $color-text;

    transition: color $transition-fast;
  }

  .footer-links a:hover {
    color: $color-accent;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;

    padding-top: 20px;
    border-top: 1px solid $color-border;

    font-family: $font-mono;
    font-size: 0.6rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: $color-muted;
  }

  .footer-meta {
    display: flex;
    gap: 24px;
  }

  .footer-meta a {
    color: $color-muted;
    transition: color $transition-fast;
  }

  .footer-meta a:hover {
    color: $color-text;
  }

  @media (max-width: 900px) {
    .footer {
      padding: 60px $container-padding 24px;
    }

    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 50px 40px;

      padding-bottom: 60px;
    }

    .footer-brand {
      grid-column: 1 / -1;
      min-height: auto;
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>

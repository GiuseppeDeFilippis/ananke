---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      nav: [
        { label: "Services", href: "/en/services" },
        { label: "Work", href: "/en/work" },
        { label: "Process", href: "/en/process" },
        { label: "Studio", href: "/en/about" },
        { label: "Contact", href: "/en/contact" },
      ],
      contact: "giuseppe@ananke.dev",
      language: "IT",
    }
  : {
      nav: [
        { label: "Servizi", href: "/servizi" },
        { label: "Progetti", href: "/progetti" },
        { label: "Processo", href: "/processo" },
        { label: "Studio", href: "/chi-sono" },
        { label: "Contatti", href: "/contatti" },
      ],
      contact: "giuseppe@ananke.dev",
      language: "EN",
    };
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-main">
      <a
        href={isEnglish ? "/en/" : "/"}
        class="footer-brand"
        aria-label="ANANKE"
      >
        <span class="footer-logo">ANANKE</span>

        <span class="footer-subtitle">
          Independent Software Studio
        </span>
      </a>

      <nav class="footer-nav" aria-label="Footer navigation">
        {
          content.nav.map((item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ))
        }

        <a
          href={isEnglish ? "/" : "/en/"}
          class="footer-language"
        >
          {content.language}
        </a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} ANANKE</span>

      <a href={`mailto:${content.contact}`}>
        {content.contact}
      </a>
    </div>
  </div>
</footer>

<style lang="scss">
  @use "../styles/variables" as *;

  .footer {
    padding: 64px 0 32px;

    background: $color-cream;
    color: $color-ink;

    border-top: 1px solid $color-border;
  }

  .footer-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;
  }

  /* --------------------------------
     Main
  -------------------------------- */

  .footer-main {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;

    padding-bottom: 64px;
  }

  .footer-brand {
    display: inline-flex;
    flex-direction: column;

    width: fit-content;
  }

  .footer-logo {
    color: $color-green;

    font-family: $font-display;
    font-size: 2rem;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .footer-subtitle {
    margin-top: 8px;

    color: $color-muted;

    font-family: $font-mono;
    font-size: 0.62rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* --------------------------------
     Navigation
  -------------------------------- */

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: flex-start;

    gap: 10px 32px;
  }

  .footer-nav a {
    color: $color-ink;

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.07em;
    text-transform: uppercase;

    transition: color $transition-fast;
  }

  .footer-nav a:hover {
    color: $color-green;
  }

  .footer-language {
    margin-left: 16px;

    color: $color-green !important;
  }

  /* --------------------------------
     Bottom
  -------------------------------- */

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding-top: 20px;

    border-top: 1px solid $color-border;

    color: $color-muted;

    font-family: $font-mono;
    font-size: 0.62rem;
    line-height: 1.4;
    letter-spacing: 0.05em;
  }

  .footer-bottom a {
    color: inherit;

    transition: color $transition-fast;
  }

  .footer-bottom a:hover {
    color: $color-green;
  }

  /* --------------------------------
     Tablet
  -------------------------------- */

  @media (max-width: 1000px) {
    .footer {
      padding-top: 56px;
    }

    .footer-main {
      grid-template-columns: 1fr 2fr;

      padding-bottom: 56px;
    }

    .footer-nav {
      gap: 10px 24px;
    }
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 768px) {
    .footer {
      padding: 48px 0 24px;
    }

    .footer-main {
      display: block;

      padding-bottom: 48px;
    }

    .footer-brand {
      margin-bottom: 40px;
    }

    .footer-nav {
      justify-content: flex-start;

      gap: 16px 24px;
    }

    .footer-language {
      margin-left: 0;
    }

    .footer-bottom {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  /* --------------------------------
     Small mobile
  -------------------------------- */

  @media (max-width: 480px) {
    .footer {
      padding-top: 40px;
    }

    .footer-main {
      padding-bottom: 40px;
    }

    .footer-nav {
      gap: 14px 20px;
    }
  }
</style>
---
const isEnglish = Astro.currentLocale === "en";

const services = isEnglish
  ? [
      {
        number: "01",
        title: "Websites",
        description:
          "Digital presences that are clear, fast and carefully designed.",
      },
      {
        number: "02",
        title: "Web applications",
        description:
          "Digital tools designed around real needs and specific workflows.",
      },
      {
        number: "03",
        title: "Custom software",
        description:
          "Tailored solutions for processes that require something more.",
      },
      {
        number: "04",
        title: "Automation",
        description: "Simpler processes through tailored tools and workflows.",
      },
    ]
  : [
      {
        number: "01",
        title: "Siti web",
        description:
          "Presenze digitali chiare, veloci e curate in ogni dettaglio.",
      },
      {
        number: "02",
        title: "Applicazioni web",
        description:
          "Strumenti digitali progettati intorno a esigenze reali e processi specifici.",
      },
      {
        number: "03",
        title: "Software su misura",
        description:
          "Soluzioni costruite per processi che richiedono qualcosa di più.",
      },
      {
        number: "04",
        title: "Automazione",
        description:
          "Processi più semplici attraverso strumenti e flussi progettati su misura.",
      },
    ];
---

<section class="services">
  <div class="services-inner">
    <div class="section-label">
      <span>/ 03</span>
      <span>{isEnglish ? "Services" : "Servizi"}</span>
    </div>

    <div class="services-list">
      {
        services.map((service) => (
          <a href="/contatti" class="service">
            <div class="service-number">{service.number}</div>

            <div class="service-content">
              <h2>{service.title}</h2>
              <p>{service.description}</p>
            </div>

            <div class="service-arrow" aria-hidden="true">
              ↗
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .services {
    padding: 180px $container-padding;
    border-top: 1px solid $color-border;
  }

  .services-inner {
    width: 100%;
    max-width: $container-max-width;
    margin: 0 auto;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 24px;

    font-family: $font-mono;
    font-size: 0.65rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-muted;
  }

  .services-list {
    margin-top: 100px;
    border-top: 1px solid $color-border;
  }

  .service {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    align-items: start;
    gap: 40px;

    padding: 42px 0;
    border-bottom: 1px solid $color-border;

    color: $color-text;
    transition: padding $transition-fast;
  }

  .service-number {
    padding-top: 8px;

    font-family: $font-mono;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: $color-muted;
  }

  .service-content h2 {
    margin: 0;

    font-family: $font-display;
    font-size: clamp(2.4rem, 4vw, 4.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .service-content p {
    max-width: 520px;
    margin: 20px 0 0;

    font-size: 0.95rem;
    line-height: 1.6;
    color: $color-muted;
  }

  .service-arrow {
    padding-top: 6px;

    font-family: $font-mono;
    font-size: 1.1rem;
    color: $color-accent;

    transition: transform $transition-fast;
  }

  .service:hover {
    padding-left: 12px;
  }

  .service:hover .service-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .services {
      padding: 120px $container-padding;
    }

    .services-list {
      margin-top: 80px;
    }

    .service {
      grid-template-columns: 48px 1fr auto;
      gap: 20px;
      padding: 32px 0;
    }

    .service-content h2 {
      font-size: clamp(2.2rem, 9vw, 3.5rem);
    }

    .service-content p {
      margin-top: 14px;
    }
  }
</style>

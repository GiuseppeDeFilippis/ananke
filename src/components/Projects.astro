---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      eyebrow: "Selected work",
      title: "Some realities ANANKE has taken shape with.",
      projects: [
        {
          name: "quandononcisono",
          href: "https://quandononcisono.it",
          placeholder: "Logo placeholder",
        },
        {
          name: "Studio Leone",
          href: "#",
          placeholder: "Logo placeholder",
        },
      ],
    }
  : {
      eyebrow: "Alcune realtà",
      title: "Con cui ANANKE ha preso forma.",
      projects: [
        {
          name: "quandononcisono",
          href: "https://quandononcisono.it",
          placeholder: "Placeholder logo",
        },
        {
          name: "Studio Leone",
          href: "#",
          placeholder: "Placeholder logo",
        },
      ],
    };
---

<section class="projects">
  <div class="projects-inner">
    <div class="projects-header">
      <span class="eyebrow">{content.eyebrow}</span>

      <h2>{content.title}</h2>
    </div>

    <div class="projects-list">
      {
        content.projects.map((project) => (
          <a
            class:list={[
              "project",
              { "project-disabled": project.href === "#" },
            ]}
            href={project.href}
            target={project.href !== "#" ? "_blank" : undefined}
            rel={project.href !== "#" ? "noopener noreferrer" : undefined}
            aria-label={project.name}
          >
            <div class="project-placeholder">
              <span>{project.placeholder}</span>
            </div>

            <div class="project-name">
              <span>{project.name}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .projects {
    padding: 140px 0 160px;

    background: $color-cream;
    color: $color-ink;
  }

  .projects-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;
  }

  /* --------------------------------
     Header
  -------------------------------- */

  .projects-header {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;

    margin-bottom: 90px;
  }

  .eyebrow {
    grid-column: 1 / span 3;

    color: $color-green;

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    grid-column: 4 / span 8;

    max-width: 800px;

    margin: 0;

    font-family: $font-display;
    font-size: clamp(3.5rem, 5.8vw, 6.2rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  /* --------------------------------
     Projects
  -------------------------------- */

  .projects-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project {
    display: block;

    color: inherit;
  }

  .project-placeholder {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    aspect-ratio: 2.4 / 1;

    border: 1px solid $color-border;

    background: $color-surface;

    color: $color-muted;

    transition:
      background-color $transition-base,
      border-color $transition-base;
  }

  .project-placeholder span {
    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-name {
    padding-top: 18px;

    font-family: $font-mono;
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project:hover .project-placeholder {
    border-color: $color-green;
    background: rgba($color-green, 0.06);
  }

  .project-disabled {
    cursor: default;
  }

  .project-disabled:hover .project-placeholder {
    border-color: $color-border;
    background: $color-surface;
  }

  /* --------------------------------
     Tablet
  -------------------------------- */

  @media (max-width: 1000px) {
    .projects {
      padding: 120px 0 140px;
    }

    .projects-header {
      margin-bottom: 72px;
    }

    h2 {
      grid-column: 4 / span 9;

      font-size: clamp(3.2rem, 5.8vw, 5.5rem);
    }
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 768px) {
    .projects {
      padding: 90px 0 100px;
    }

    .projects-header {
      display: block;

      margin-bottom: 56px;
    }

    .eyebrow {
      display: block;

      margin-bottom: 40px;
    }

    h2 {
      font-size: clamp(3rem, 13vw, 5rem);
      line-height: 0.92;
    }

    .projects-list {
      grid-template-columns: 1fr;

      gap: 48px;
    }

    .project-placeholder {
      aspect-ratio: 2 / 1;
    }
  }

  /* --------------------------------
     Small mobile
  -------------------------------- */

  @media (max-width: 480px) {
    .projects {
      padding: 72px 0 80px;
    }

    .projects-header {
      margin-bottom: 48px;
    }

    .eyebrow {
      margin-bottom: 32px;
    }

    h2 {
      font-size: clamp(2.8rem, 13.5vw, 4.5rem);
    }

    .projects-list {
      gap: 40px;
    }

    .project-placeholder {
      aspect-ratio: 1.8 / 1;
    }
  }
</style>
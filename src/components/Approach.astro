---
const isEnglish = Astro.currentLocale === "en";

const content = isEnglish
  ? {
      eyebrow: "The process",
      title:
        "There is no solution before there is an understanding of the problem.",
      steps: [
        {
          number: "01",
          title: "Understand",
          description:
            "We start with the context, the people involved and what actually needs to change.",
        },
        {
          number: "02",
          title: "Shape",
          description:
            "We turn needs, ideas and constraints into a clear direction for the project.",
        },
        {
          number: "03",
          title: "Build",
          description:
            "We choose the right tools and turn the direction into something real, useful and reliable.",
        },
        {
          number: "04",
          title: "Refine",
          description:
            "We test, adjust and simplify until the result works as it should.",
        },
      ],
    }
  : {
      eyebrow: "Il processo",
      title: "Non esiste una soluzione prima di aver capito il problema.",
      steps: [
        {
          number: "01",
          title: "Capire",
          description:
            "Partiamo dal contesto, dalle persone coinvolte e da ciò che deve realmente cambiare.",
        },
        {
          number: "02",
          title: "Dare forma",
          description:
            "Trasformiamo esigenze, idee e vincoli in una direzione chiara per il progetto.",
        },
        {
          number: "03",
          title: "Costruire",
          description:
            "Scegliamo gli strumenti giusti e trasformiamo la direzione in qualcosa di reale, utile e affidabile.",
        },
        {
          number: "04",
          title: "Affinare",
          description:
            "Testiamo, correggiamo e semplifichiamo fino a quando il risultato funziona davvero.",
        },
      ],
    };
---

<section class="process">
  <div class="process-inner">
    <div class="process-header">
      <span class="eyebrow">{content.eyebrow}</span>

      <h2>{content.title}</h2>
    </div>

    <div class="process-list">
      {
        content.steps.map((step) => (
          <div class="process-step">
            <span class="step-number">{step.number}</span>

            <h3>{step.title}</h3>

            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .process {
    padding: 140px 0 160px;

    background: $color-green;
    color: $color-cream;
  }

  .process-inner {
    width: min(
      calc(100% - (#{$container-padding} * 2)),
      $container-max-width
    );

    margin-inline: auto;
  }

  /* --------------------------------
     Header
  -------------------------------- */

  .process-header {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;

    margin-bottom: 100px;
  }

  .eyebrow {
    grid-column: 1 / span 3;

    color: rgba(245, 243, 238, 0.72);

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    grid-column: 4 / span 8;

    max-width: 850px;

    margin: 0;

    color: $color-cream;

    font-family: $font-display;
    font-size: clamp(3.5rem, 5.8vw, 6.2rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  /* --------------------------------
     Process list
  -------------------------------- */

  .process-list {
    border-top: 1px solid rgba(245, 243, 238, 0.25);
  }

  .process-step {
    display: grid;
    grid-template-columns: 1fr 3fr 5fr;
    gap: 24px;

    padding: 38px 0 40px;

    border-bottom: 1px solid rgba(245, 243, 238, 0.25);
  }

  .step-number {
    color: rgba(245, 243, 238, 0.72);

    font-family: $font-mono;
    font-size: 0.68rem;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0;

    color: $color-cream;

    font-family: $font-display;
    font-size: clamp(2rem, 3vw, 3.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .process-step p {
    max-width: 480px;

    margin: 2px 0 0;

    color: rgba(245, 243, 238, 0.72);

    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* --------------------------------
     Tablet
  -------------------------------- */

  @media (max-width: 1000px) {
    .process {
      padding: 120px 0 140px;
    }

    .process-header {
      margin-bottom: 80px;
    }

    h2 {
      grid-column: 4 / span 9;

      font-size: clamp(3.2rem, 5.8vw, 5.5rem);
    }

    .process-step {
      grid-template-columns: 1fr 3fr 6fr;
    }
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 768px) {
    .process {
      padding: 90px 0 100px;
    }

    .process-header {
      display: block;

      margin-bottom: 64px;
    }

    .eyebrow {
      display: block;

      margin-bottom: 40px;
    }

    h2 {
      font-size: clamp(3rem, 13vw, 5rem);
      line-height: 0.92;
    }

    .process-step {
      grid-template-columns: 40px 1fr;

      gap: 16px;

      padding: 32px 0 34px;
    }

    .step-number {
      grid-row: 1 / span 2;
    }

    h3 {
      font-size: clamp(2rem, 8vw, 2.7rem);
    }

    .process-step p {
      max-width: 440px;

      margin-top: 16px;

      font-size: 0.92rem;
    }
  }

  /* --------------------------------
     Small mobile
  -------------------------------- */

  @media (max-width: 480px) {
    .process {
      padding: 72px 0 80px;
    }

    .process-header {
      margin-bottom: 48px;
    }

    .eyebrow {
      margin-bottom: 32px;
    }

    h2 {
      font-size: clamp(2.8rem, 13.5vw, 4.5rem);
    }

    .process-step {
      grid-template-columns: 32px 1fr;

      gap: 12px;

      padding: 28px 0 30px;
    }

    h3 {
      font-size: 2rem;
    }
  }
</style>